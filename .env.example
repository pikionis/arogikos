APP_NAME=Arogi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Greek-only site. el drives Carbon date localisation.
APP_TIMEZONE=Europe/Athens
APP_LOCALE=el
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=el_GR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses SQLite (zero-config). For an EU/GDPR production host,
# switch to MySQL/MariaDB and fill the credentials below.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=arogi
# DB_USERNAME=arogi
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Dev: log (writes mails to storage/logs/laravel.log).
# Production: set MAIL_MAILER=smtp and fill the SMTP credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@arogikos.gr"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# pikionis/cms-core (admin panel + content models)
# -----------------------------------------------------------------------------
# These are consumed once the cms-core package is wired in (see README "Swap to
# cms-core"). They are read by the package's config/cms.php, not by the site.
# CMS_PANEL_NAME="Διαχείριση"
# CMS_PRIMARY_COLOR="#1E9E58"
# CMS_MODULE_PAGES=true
# CMS_MODULE_ARTICLES=true
# CMS_MODULE_EVENTS=true
# CMS_MODULE_GALLERY=true
# CMS_ROLE_ADMIN="Διαχειριστής"
# CMS_ROLE_TEACHER="Εκπαιδευτικός"
